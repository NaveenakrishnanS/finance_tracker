# Copy this file to .env and fill in the values before running docker compose.
# Never commit .env to version control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=finance_tracker
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=strong_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters long and kept secret.
APP_JWT_SECRET=change_me_to_a_very_long_random_secret_string
APP_JWT_EXPIRY_MS=7200000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Since the frontend is served by the same app, this can be the app's own URL.
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080

# ── Host port ─────────────────────────────────────────────────────────────────
# The port exposed on the host machine.
HOST_PORT=8080
